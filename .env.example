# CSE API Integration Configuration
# Add your API keys here for real data fetching

# Alpha Vantage API Key (free tier available)
# Get from: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Twelve Data API Key (free tier available)
# Get from: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# IEX Cloud API Key (free tier available)
# Get from: https://iexcloud.io/
IEX_CLOUD_API_KEY=your_iex_cloud_key_here

# OpenAI API Key (for AI analysis)
OPENAI_API_KEY=your_openai_key_here

# AWS Configuration (for cloud deployment)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# Data Collection Settings
DATA_CACHE_DAYS=30
API_TIMEOUT_SECONDS=30
MAX_RETRIES=3